{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "篮球战术板",
  "version": "1.0.0",
  "identifier": "com.alexanderwolf.basketball-tactics-board",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "篮球战术板",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"]
      }
    }
  }
}